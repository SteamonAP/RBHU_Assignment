# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- Database (matches docker-compose.yml: host port 5433 -> container 5432) ----
DATABASE_URL="postgresql://postgres:postgres123@127.0.0.1:5433/assessment_db?schema=public"

# ---- Authentication ----
# Use a long, random value in any real environment.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=15m

# ---- CORS ----
CORS_ORIGIN=http://localhost:5173

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# ---- AI assistant ----
# mock  = offline deterministic provider (no API key, no local model required)
# ollama = local LLM served by Ollama
AI_PROVIDER=mock
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# ---- OpenAI / OpenAI-compatible provider (including Azure OpenAI v1) ----
# Set AI_PROVIDER=openai and configure the key to enable hosted responses.
# AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
